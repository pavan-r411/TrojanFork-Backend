# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

GOOGLE_MAPS_API_KEY=

# Optional authorized web search (not HTML scraping)
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=none

# Runtime
DATABASE_URL=sqlite:///./data/trojanbites.db
LOG_LEVEL=INFO
MAX_LLM_USD_PER_DAY=25
MAX_PLACES_REQUESTS_PER_DAY=500

# Optional gate for POST /v1/ingestion/jobs (leave empty to allow local pilot)
INGEST_API_TOKEN=