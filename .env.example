# Copy to .env. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_S=8
RECOMMENDATION_PROVIDER=openai
RECOMMENDATION_CANDIDATE_LIMIT=30
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=35
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
DATABASE_URL=sqlite:///./data/trojanbites.db
PROVIDER_RECORDS_ENABLED=false
PROVIDER_RECORDS_DIR=data/provider_records
LOG_LEVEL=INFO
INGEST_API_TOKEN=
# Live plan (/v1/live/plan)
LIVE_SNAPSHOT_SUPPLEMENT=true
LIVE_RESTAURANT_LIMIT=6
PLACES_PHOTOS_ENABLED=true
# Bearer sessions (POST /v1/auth/login). Hours until the token expires.
SESSION_TTL_HOURS=168
